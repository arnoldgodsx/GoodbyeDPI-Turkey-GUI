<UserControl x:Class="Hub.Modules.GoodbyeDpi.GoodbyeDpiPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hub="clr-namespace:Hub">
    <StackPanel>

        <TextBlock Text="GoodbyeDPI" Style="{StaticResource Title}" hub:Motion.Reveal="True"/>

        <Grid Margin="0,36,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Sol: aç/kapat + otomatik başlatma -->
            <StackPanel Margin="0,0,32,0">
                <ToggleButton x:Name="MainSwitch" Style="{StaticResource PowerSwitch}" HorizontalAlignment="Left"
                              Click="OnMainToggle" hub:Motion.Reveal="True"/>

                <StackPanel Orientation="Horizontal" Margin="0,36,0,0" hub:Motion.Reveal="True">
                    <ToggleButton x:Name="AutoSwitch" Style="{StaticResource Switch}" Click="OnAutoToggle"/>
                    <TextBlock Text="Windows ile başlat" Style="{StaticResource RowText}" Margin="14,0,0,0"/>
                </StackPanel>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontSize="12.5" TextWrapping="Wrap"
                           Margin="0,24,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Sağ: profil -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="Profil" Style="{StaticResource Label}" Margin="0,0,0,10" hub:Motion.Reveal="True"/>
                <StackPanel x:Name="ProfileList" hub:Motion.Reveal="True">
                    <Border Style="{StaticResource Hairline}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
