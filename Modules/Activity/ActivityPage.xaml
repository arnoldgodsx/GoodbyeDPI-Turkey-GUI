<UserControl x:Class="Hub.Modules.Activity.ActivityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hub="clr-namespace:Hub">
    <StackPanel>

        <TextBlock Text="GitHub Activity" Style="{StaticResource Title}" hub:Motion.Reveal="True"/>

        <!-- Bugünkü sayı -->
        <StackPanel Orientation="Horizontal" Margin="-6,36,0,0" hub:Motion.Reveal="True">
            <TextBlock x:Name="CountText" Text="0" FontSize="128" FontWeight="Light"
                       LineHeight="112" LineStackingStrategy="BlockLineHeight"/>
            <TextBlock x:Name="TargetText" FontSize="40" FontWeight="Light" Foreground="{StaticResource Faint}"
                       VerticalAlignment="Bottom" Margin="10,0,0,4"/>
        </StackPanel>

        <hub:TickBar x:Name="Ticks" Height="30" Margin="0,22,0,0" hub:Motion.Reveal="True"
                     Fill="{StaticResource Text}" Track="{StaticResource Track}"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontSize="12.5" TextWrapping="Wrap"
                   Margin="0,12,0,0" Visibility="Collapsed"/>

        <!-- Kontrol saatleri -->
        <Grid Margin="0,30,0,0" hub:Motion.Reveal="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Son kontrol" Style="{StaticResource Label}"/>
                <TextBlock x:Name="LastText" Text="—" FontSize="20" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Sonraki kontrol" Style="{StaticResource Label}"/>
                <TextBlock x:Name="NextText" Text="—" FontSize="20" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Hairline}" Margin="0,28,0,0" hub:Motion.Reveal="True"/>

        <Grid Margin="0,24,0,0" hub:Motion.Reveal="True">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="CloudSwitch" Style="{StaticResource Switch}" Opacity="0" IsHitTestVisible="False" Click="OnCloudToggle"/>
                <TextBlock Text="GitHub yedeği" Style="{StaticResource RowText}" Margin="14,0,0,0"/>
            </StackPanel>
            <Button x:Name="CheckButton" Style="{StaticResource PrimaryButton}" Content="Şimdi kontrol et"
                    HorizontalAlignment="Right" Click="OnCheck"/>
        </Grid>
    </StackPanel>
</UserControl>
