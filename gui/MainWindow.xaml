<Window x:Class="Hub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hub" Icon="/Assets/hub.ico" Width="900" Height="580"
        WindowStyle="SingleBorderWindow" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" FontFamily="{StaticResource Sans}" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <!-- Başlık çubuğu yok ama pencere çerçevesi duruyor: Windows 11 köşe, gölge ve küçültme animasyonu gelir. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate x:Key="NavTemplate">
            <Border Height="44">
                <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="Medium" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </DataTemplate>

        <Style x:Key="NavList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}"/>
            <Setter Property="ItemTemplate" Value="{StaticResource NavTemplate}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="{StaticResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================================================== Kenar çubuğu -->
        <Grid Background="#06FFFFFF" MouseLeftButtonDown="OnDrag">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.RowSpan="3" HorizontalAlignment="Right" Width="1" Background="{StaticResource Line}"/>

            <!-- Logo: tools\make-icon.ps1 ile aynı işaret (merkez nokta, açık halka, uydu) -->
            <StackPanel Orientation="Horizontal" Margin="26,26,0,30">
                <Canvas x:Name="Mark" Width="22" Height="22" VerticalAlignment="Center" Margin="0,2,10,0">
                    <Path Data="M18.09,8.56 A7.5,7.5 0 1 1 13.44,3.91" Stroke="{StaticResource Text}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Ellipse Canvas.Left="8.6" Canvas.Top="8.6" Width="4.8" Height="4.8" Fill="{StaticResource Text}"/>
                    <Ellipse Canvas.Left="14.8" Canvas.Top="4.2" Width="3" Height="3" Fill="{StaticResource Text}"/>
                </Canvas>
                <TextBlock Text="hub" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <ListBox x:Name="ModuleList" Grid.Row="1" Style="{StaticResource NavList}" SelectionChanged="OnModuleSelected"/>
            <ListBox x:Name="FooterList" Grid.Row="2" Style="{StaticResource NavList}" SelectionChanged="OnModuleSelected" Margin="0,0,0,16"/>
        </Grid>

        <!-- ======================================================== İçerik -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Background="Transparent" MouseLeftButtonDown="OnDrag">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Button Style="{StaticResource WinButton}" ToolTip="Küçült" Click="OnMinimize">
                        <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button Style="{StaticResource WinButton}" ToolTip="Arka plana gönder" Click="OnHide" Margin="2,0,0,0">
                        <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>
            </Grid>

            <ContentControl x:Name="PageHost" Grid.Row="1" Margin="52,0,52,44" Focusable="False"/>
        </Grid>
    </Grid>
</Window>
